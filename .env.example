# Server-only. Never rename this to a VITE_* variable or expose it to the browser.
OPENAI_API_KEY=

# EVA uses the OpenAI Responses API with strict function tools.
EVA_MODEL=gpt-5.4-mini

# Google OAuth web application credentials. Server-only: never use VITE_ prefixes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_SESSION_SECRET=
